<%= form_with model: account, class: "account-form" do |f| %>
  <% if account.errors.any? %>
    <div class="form-errors">
      <strong>Couldn’t save this account:</strong>
      <ul>
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, autofocus: true, placeholder: "e.g. Managed TFSA" %>
  </div>

  <div class="form-field">
    <%= f.label :institution %>
    <%= f.text_field :institution, placeholder: "e.g. Wealthsimple" %>
  </div>

  <div class="form-field">
    <%= f.label :kind %>
    <%= f.select :kind, Account.kind_options, { prompt: "Choose a type…" }, required: true %>
  </div>

  <p class="form-hint">Liability details (used for mortgages — leave blank for other types):</p>

  <div class="form-field">
    <%= f.label :interest_rate, "Interest rate (%)" %>
    <%= f.number_field :interest_rate, step: 0.001, min: 0, placeholder: "e.g. 4.89" %>
  </div>

  <div class="form-field">
    <%= f.label :term_months, "Term (months)" %>
    <%= f.number_field :term_months, step: 1, min: 1, placeholder: "e.g. 60" %>
  </div>

  <div class="form-field">
    <%= f.label :original_principal %>
    <%= f.number_field :original_principal, step: 0.01, min: 0, placeholder: "e.g. 450000" %>
  </div>

  <p class="form-hint">Credit-card details (no balances — just why you keep the card):</p>

  <div class="form-field">
    <%= f.label :annual_fee %>
    <%= f.number_field :annual_fee, step: 0.01, min: 0, placeholder: "e.g. 139" %>
  </div>

  <div class="form-field">
    <%= f.label :perks %>
    <%= f.text_area :perks, rows: 3, placeholder: "e.g. Free first checked bag, lounge access…" %>
  </div>

  <div class="form-field">
    <%= f.label :renewal_on, "Renewal date" %>
    <%= f.date_field :renewal_on %>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
  </div>
<% end %>
