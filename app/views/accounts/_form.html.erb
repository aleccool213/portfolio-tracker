<%= form_with model: account, class: "account-form", data: { controller: "account-fields" } do |f| %>
  <% if account.errors.any? %>
    <div class="form-errors">
      <strong>Couldn’t save this account:</strong>
      <ul>
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= f.label :name %>
    <%= f.text_field :name, required: true, autofocus: true, placeholder: "e.g. Managed TFSA" %>
  </div>

  <div class="form-field">
    <%= f.label :institution %>
    <%= f.text_field :institution, placeholder: "e.g. Wealthsimple" %>
  </div>

  <div class="form-field">
    <%= f.label :kind %>
    <%= f.select :kind, Account.kind_options, { prompt: "Choose a type…" },
          required: true,
          data: { account_fields_target: "kind", action: "change->account-fields#toggle" } %>
  </div>

  <%# One group per product type; the Stimulus controller shows the matching one. %>
  <%= render "asset_fields", f: f %>
  <%= render "mortgage_fields", f: f %>
  <%= render "credit_card_fields", f: f %>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", root_path, class: "btn btn-ghost" %>
  </div>
<% end %>
