<article class="card">
  <div class="dot"><%= kind_emoji(product.record.kind) %></div>
  <div class="body">
    <div class="name"><%= product.name %></div>
    <div class="meta"><%= product.institution %></div>
  </div>
  <div class="field">
    <span class="field-prefix">$</span>
    <%= number_field_tag "values[#{product.id}]", current&.amount,
          step: 0.01, inputmode: "decimal", placeholder: "0.00",
          "aria-label": "#{product.name} value" %>
  </div>
</article>
