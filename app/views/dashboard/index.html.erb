<% content_for :title, "Your money, at a glance" %>

<div class="wrap">
  <header class="masthead">
    <h1>Hey there <span class="wave">👋</span></h1>
    <p>Here's everything in one place.</p>
  </header>

  <% if @portfolio.needs_check_in? %>
    <div class="reminder">
      <span class="emoji">🗓️</span>
      <div>
        <strong>It's a fresh month — time for a check-in.</strong>
        <span>On the 1st, jot down what each account is worth.</span>
        <%= link_to "Enter this month's values →", value_entry_path, class: "reminder-link" %>
      </div>
    </div>
  <% else %>
    <div class="reminder reminder-ok">
      <span class="emoji">✅</span>
      <div>
        <strong>You're all caught up ✅</strong>
        <span>This month's values are in. Nice work.</span>
      </div>
    </div>
  <% end %>

  <section class="hero">
    <div class="label">Net worth</div>
    <div class="value"><%= formatted_amount(@portfolio.net_worth) %></div>
    <% if (change = change_badge(@portfolio.monthly_change)) %>
      <div class="change"><%= change %></div>
    <% end %>
  </section>

  <%= render "allocation", allocation: @allocation %>

  <div class="section-title-row">
    <h2 class="section-title">Your accounts</h2>
    <%= link_to "Add account", new_account_path, class: "section-action" %>
  </div>

  <% if @value_accounts.any? %>
    <div class="cards">
      <% @value_accounts.each do |account| %>
        <article class="card">
          <div class="dot"><%= kind_emoji(account.kind) %></div>
          <div class="body">
            <div class="name"><%= account.name %></div>
            <div class="meta"><%= account.institution %></div>
            <% if account.mortgage? && account.interest_rate.present? %>
              <div class="meta liability-meta">
                <%= number_to_percentage(account.interest_rate, precision: 2) %>
                <% if account.term_months.present? %>
                  · <%= account.term_months / 12 %> yr term
                <% end %>
              </div>
            <% end %>
            <div class="card-actions">
              <%= link_to "Edit", edit_account_path(account) %>
              <%= button_to "Delete", account_path(account), method: :delete,
                    form: { data: { turbo_confirm: "Remove #{account.name}? Its value history goes too." } },
                    class: "link-button" %>
            </div>
          </div>
          <div class="figures">
            <div class="amount"><%= formatted_amount(account.current_amount) %></div>
            <%= monthly_change_badge(account) %>
            <%= render "sparkline", account: account %>
            <div class="tag"><%= account.kind_label %></div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty">
      <p>No accounts yet. <%= link_to "Add an account", new_account_path %> to get started.</p>
    </div>
  <% end %>

  <% if @cards.any? %>
    <div class="section-title-row">
      <h2 class="section-title">Your cards</h2>
    </div>
    <p class="section-note">Perks and fees only — cards never count toward net worth.</p>
    <div class="cards">
      <% @cards.each do |card| %>
        <article class="card card-perk">
          <div class="dot"><%= kind_emoji(card.kind) %></div>
          <div class="body">
            <div class="name"><%= card.name %></div>
            <div class="meta"><%= card.institution %></div>
            <% if card.perks.present? %>
              <p class="perks"><%= simple_format(card.perks, {}, wrapper_tag: "span") %></p>
            <% end %>
            <div class="card-actions">
              <%= link_to "Edit", edit_account_path(card) %>
              <%= button_to "Delete", account_path(card), method: :delete,
                    form: { data: { turbo_confirm: "Remove #{card.name}?" } },
                    class: "link-button" %>
            </div>
          </div>
          <div class="figures">
            <div class="amount">
              <% if card.annual_fee.present? %>
                <%= number_to_currency(card.annual_fee, unit: "$", precision: 0) %><span class="fee-label">/yr</span>
              <% else %>
                —
              <% end %>
            </div>
            <% if card.renewal_on.present? %>
              <div class="tag">Renews <%= card.renewal_on.strftime("%b %Y") %></div>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>

  <%= render "suggestions", suggestions: @suggestions %>

  <p class="footnote">
    Bringing numbers over from a spreadsheet?
    <%= link_to "Import a CSV →", import_path %>
  </p>
</div>
